# Jisr environment variables. Copy to .env.local for local overrides; never commit real values.
# The guest release needs none: every variable below is optional and the site is safe without them.
# The NEXT_PUBLIC_ values are validated at build time (src/lib/site-env.ts); a malformed one fails `next build`.
#
# Public origin of the site, e.g. https://jisr.vercel.app (no path, no trailing slash). Set it ONLY in
# the Vercel *Production* environment scope. Unset => the build is not indexable: robots.txt
# disallows everything, pages send X-Robots-Tag: noindex, and there is no canonical URL and the sitemap is empty.
# This is what keeps preview deployments out of search engines.
# NEXT_PUBLIC_SITE_URL=
# Base URL of the published data snapshots. Defaults to /snapshots (same origin); set it only when
# snapshots move to a CDN (ADR 0004). The relative form is exactly /snapshots; otherwise an https://
# URL with no trailing slash.
# NEXT_PUBLIC_SNAPSHOT_BASE_URL=
# GoatCounter endpoint, https://<code>.goatcounter.com/count. Only used when the build is indexable
# (production). Unset => no analytics script is rendered at all.
# NEXT_PUBLIC_GOATCOUNTER_URL=
#
# Phase 2 (accounts, Neon EU, Better Auth; decisions in ADR 0013). Used only while ACCOUNTS_ENABLED (the
# last entry) is on: with it empty the site is guest-only and none of these needs a value. When accounts go
# live set them in the Vercel *Production* scope only, so previews and local runs stay guest-only.
# Neon connection strings (project in Frankfurt, Postgres 16 or newer): DATABASE_URL is the pooled one
# (runtime), DATABASE_URL_UNPOOLED the direct one (drizzle-kit migrations). Both empty until the Neon project exists.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Better Auth core: random secret (e.g. `openssl rand -base64 32`) and the exact public origin of the site
# (an https origin, no path). Email links and the Google redirect URI are built from the origin, and it is
# never inferred from a request. While accounts are on, a missing or invalid value answers 500.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Google OAuth sign-in (Google Cloud console credentials). Authorised redirect URI in the console:
# <BETTER_AUTH_URL>/api/auth/callback/google (plus http://localhost:3000/api/auth/callback/google for local runs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Brevo transactional email for magic links and account-deletion confirmations (called via fetch, no SDK).
# Empty BREVO_API_KEY = no provider: only when NODE_ENV is exactly development or test is the rendered
# email written to tests/e2e/.mail/ instead; anything else (production, unset, misspelled) is an error
# unless JISR_EMAIL_FILE_TRANSPORT=1.
BREVO_API_KEY=
# Sender as `Name <address>` or a bare address, on a domain verified in Brevo, e.g. Jisr <no-reply@jisrr.org>.
BREVO_SENDER=
# Set to 1 to allow the file transport outside development and test (where it is already allowed). tests/e2e only; never set on Vercel.
JISR_EMAIL_FILE_TRANSPORT=
# The accounts kill switch, read on every request. Only the exact values `true` or `1` (case and surrounding
# spaces ignored) turn accounts on; empty, unset or any other value keeps the site guest-only. Leave it empty
# until the owner has cleared the launch gates in docs/ops/prelaunch-checklist.md (CNDP declaration, controller
# name and contact, sending domain, security review). Code, CI and docs never set it. Static pages read it when
# they are built, so a change also needs a redeploy before the sign-in pages appear or disappear.
ACCOUNTS_ENABLED=
