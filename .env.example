# Jisr environment variables. Copy to .env.local for local overrides; never commit real values.
# The guest release needs none: every variable below is optional and the site is safe without them.
# Values are validated at build time (src/lib/site-env.ts); a malformed value fails `next build`.
#
# Public origin of the site, e.g. https://jisr.vercel.app (no path, no trailing slash). Set it ONLY in
# the Vercel *Production* environment scope. Unset => the build is not indexable: robots.txt
# disallows everything, pages send X-Robots-Tag: noindex, and there is no canonical URL and the sitemap is empty.
# This is what keeps preview deployments out of search engines.
# NEXT_PUBLIC_SITE_URL=
# Base URL of the published data snapshots. Defaults to /snapshots (same origin); set it only when
# snapshots move to a CDN (ADR 0004). The relative form is exactly /snapshots; otherwise an https://
# URL with no trailing slash.
# NEXT_PUBLIC_SNAPSHOT_BASE_URL=
# GoatCounter endpoint, https://<code>.goatcounter.com/count. Only used when the build is indexable
# (production). Unset => no analytics script is rendered at all.
# NEXT_PUBLIC_GOATCOUNTER_URL=
#
# Phase 2 (accounts, Neon EU, Better Auth):
# Neon connection strings: DATABASE_URL is the pooled one (runtime), DATABASE_URL_UNPOOLED the
# direct one (drizzle-kit migrations). Both empty until the Neon project exists.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Better Auth core: random secret (e.g. `openssl rand -base64 32`) and the site origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Google OAuth sign-in (Google Cloud console credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Brevo transactional email for magic links and account-deletion confirmations (called via fetch, no SDK).
# Empty BREVO_API_KEY = no provider: only when NODE_ENV is exactly development or test is the rendered
# email written to tests/e2e/.mail/ instead; anything else (production, unset, misspelled) is an error
# unless JISR_EMAIL_FILE_TRANSPORT=1.
BREVO_API_KEY=
# Sender as `Name <address>` or a bare address, on a domain verified in Brevo, e.g. Jisr <no-reply@jisrr.org>.
BREVO_SENDER=
# Set to 1 to allow the file transport under NODE_ENV=production. tests/e2e only; never set on Vercel.
JISR_EMAIL_FILE_TRANSPORT=
# Set to true only after the CNDP declaration is filed; any other value keeps accounts off.
ACCOUNTS_ENABLED=
